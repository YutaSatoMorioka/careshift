<?xml version="1.0" encoding="UTF-8"?>

<web-app
    xmlns="https://jakarta.ee/xml/ns/jakartaee"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        https://jakarta.ee/xml/ns/jakartaee
        https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
    version="6.0"
    metadata-complete="false">

    <display-name>Care Shift</display-name>

    <!--
        アノテーションによるAction、Filter、Listenerの検出を有効にする。

        metadata-complete="false"のため、
        @WebFilter、@WebListenerなどは引き続き使用できる。
    -->

    <!-- 403: 権限なし -->
    <error-page>
        <error-code>403</error-code>
        <location>/error.jsp</location>
    </error-page>

    <!-- 404: ページなし -->
    <error-page>
        <error-code>404</error-code>
        <location>/error.jsp</location>
    </error-page>

    <!-- 405: 許可されていないHTTPメソッド -->
    <error-page>
        <error-code>405</error-code>
        <location>/error.jsp</location>
    </error-page>

    <!-- 500: サーバー内部エラー -->
    <error-page>
        <error-code>500</error-code>
        <location>/error.jsp</location>
    </error-page>

    <!--
        未処理例外。

        Java側の例外名・メッセージ・スタックトレースは
        画面へ表示せず、共通エラー画面へ転送する。
    -->
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/error.jsp</location>
    </error-page>

</web-app>