<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<jsp:include page="/common/header.jsp"><jsp:param name="title" value="休息支援"/></jsp:include><section class="page-content"><h1>休息リクエスト</h1><p>休みたい日時を登録して、家族に協力を依頼します。</p>
<form method="post" action="${pageContext.request.contextPath}/careshift/main/Rest.action"><label>開始<input type="datetime-local" name="startsAt" required/></label><label>終了<input type="datetime-local" name="endsAt" required/></label><label>内容<textarea name="note" maxlength="300"></textarea></label><button>休息を依頼する</button></form>
<h2>休息予定・実績</h2><c:if test="${empty rests}"><p>記録はありません。</p></c:if><table><thead><tr><th>利用者</th><th>開始</th><th>終了</th><th>内容</th><th>状態</th></tr></thead><tbody><c:forEach var="r" items="${rests}"><tr><td><c:out value="${r.display_name}"/></td><td><c:out value="${r.starts_at}"/></td><td><c:out value="${r.ends_at}"/></td><td><c:out value="${r.note}"/></td><td><c:out value="${r.status}"/></td></tr></c:forEach></tbody></table>
<h2>今月の休息レポート</h2><table><thead><tr><th>家族</th><th>回数</th><th>時間（分）</th></tr></thead><tbody><c:forEach var="x" items="${report}"><tr><td><c:out value="${x.display_name}"/></td><td><c:out value="${x.rest_count}"/></td><td><c:out value="${x.rest_minutes}"/></td></tr></c:forEach></tbody></table></section><jsp:include page="/common/footer.jsp"/>

