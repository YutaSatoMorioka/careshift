<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!doctype html><html lang="ja"><head><meta charset="UTF-8"><title>タスク分担表</title><style>body{font-family:sans-serif;margin:2rem}table{width:100%;border-collapse:collapse}th,td{border:1px solid #555;padding:.5rem;text-align:left}@media print{button{display:none}}</style></head><body><h1>Care Shift 家族タスク分担表</h1><button onclick="window.print()">印刷／PDFに保存</button><table><thead><tr><th>タスク</th><th>期限</th><th>担当者</th><th>所要時間</th><th>進捗</th></tr></thead><tbody><c:forEach var="t" items="${tasks}"><tr><td><c:out value="${t.title}"/></td><td><c:out value="${t.due_at}"/></td><td><c:out value="${t.assignee_name}"/></td><td><c:out value="${t.duration_minutes}"/>分</td><td><c:out value="${t.status}"/></td></tr></c:forEach></tbody></table></body></html>
