<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<jsp:include page="/common/header.jsp"><jsp:param name="title" value="負担状況"/></jsp:include><section class="page-content"><h1>家族のタスク負担</h1><p>未完了タスクの所要時間で集計しています。</p><c:forEach var="m" items="${workload}"><div><strong><c:out value="${m.display_name}"/></strong>：<c:out value="${m.task_count}"/>件・<c:out value="${m.minutes}"/>分<div style="background:#e5e7eb;height:18px;max-width:600px"><div style="background:#2f7667;height:18px;width:${totalMinutes gt 0 ? (m.minutes * 100 / totalMinutes) : 0}%"></div></div></div></c:forEach><p>合計 <c:out value="${totalMinutes}"/>分</p><p>一人に70%以上かつ未完了タスク3件以上が集中すると、主介護者へ通知します（同日1回）。</p></section><jsp:include page="/common/footer.jsp"/>

