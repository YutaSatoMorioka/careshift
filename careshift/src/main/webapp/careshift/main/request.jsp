<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<jsp:include page="/common/header.jsp"><jsp:param name="title" value="家族への依頼"/></jsp:include><section class="page-content"><h1>依頼カード</h1>
<h2>依頼を作成</h2><form method="post" action="${pageContext.request.contextPath}/careshift/main/Request.action"><label>種類<select name="type"><option value="TASK">タスク依頼</option><option value="REST">休息の協力依頼</option></select></label><label>タイトル<input name="title" maxlength="100" required/></label><label>内容<textarea name="body" maxlength="1000"></textarea></label><label>希望日時<input type="datetime-local" name="requestedAt"/></label><label>所要時間（分）<input type="number" min="5" max="1440" name="durationMinutes"/></label><button>家族へ送る</button></form>
<h2>依頼一覧</h2><c:if test="${empty requests}"><p>依頼はありません。</p></c:if><c:forEach var="r" items="${requests}"><article class="card"><h3><c:out value="${r.title}"/>（<c:out value="${r.type}"/>）</h3><p><c:out value="${r.body}"/></p><p>依頼者：<c:out value="${r.requester_name}"/> / 状態：<c:out value="${r.status}"/></p><c:forEach var="a" items="${r.responses}"><p>回答: <c:out value="${a.display_name}"/> — <c:out value="${a.choice}"/> <c:out value="${a.message}"/></p></c:forEach><form method="post" action="${pageContext.request.contextPath}/careshift/main/RequestRespond.action"><input type="hidden" name="requestId" value="${r.id}"/><label>回答<select name="choice"><option>担当する</option><option>今回は難しい</option><option>別のタスクならできる</option></select></label><label>メッセージ<input name="message" maxlength="500"/></label><button>回答する</button></form></article></c:forEach>
<p><a href="${pageContext.request.contextPath}/careshift/main/TaskList.action">戻る</a></p></section><jsp:include page="/common/footer.jsp"/>

