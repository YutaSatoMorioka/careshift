<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<jsp:include page="/common/header.jsp"><jsp:param name="title" value="通知"/></jsp:include><section class="page-content"><h1>通知</h1><form method="post" action="${pageContext.request.contextPath}/careshift/main/Notification.action"><button>すべて既読にする</button></form><c:if test="${empty notifications}"><p>通知はありません。</p></c:if><ul><c:forEach var="n" items="${notifications}"><li><c:if test="${not n.is_read}"><strong>未読: </strong></c:if><c:out value="${n.message}"/> (<c:out value="${n.created_at}"/>) <c:if test="${not empty n.link_path}"><a href="${pageContext.request.contextPath}${n.link_path}">開く</a></c:if></li></c:forEach></ul></section><jsp:include page="/common/footer.jsp"/>

