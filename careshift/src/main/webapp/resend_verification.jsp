<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><jsp:include page="/common/header.jsp"><jsp:param name="title" value="確認メール再送"/></jsp:include><section><h1>確認メールを再送します</h1><p>該当する登録がある場合、確認メールを再送します。メールアドレスが登録済みかどうかは画面に表示しません。</p><form method="post" action="${pageContext.request.contextPath}/careshift/ResendVerification.action"><label>メールアドレス<input type="email" name="email" required maxlength="254" value="<c:out value='${email}'/>"/></label><button>確認メールを再送</button></form><p><a href="${pageContext.request.contextPath}/login.jsp">ログインへ</a></p></section><jsp:include page="/common/footer.jsp"/>

